<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="30dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textAlignment="center"
        android:textSize="30dp"
        android:text="Fonda Doña Florinda" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textAlignment="center"
        android:textSize="20dp"
        android:text="Selecciona la acción" />

    <Button
        android:id="@+id/altas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:onClick="agregar"
        android:text="Altas de comida" />

    <Button
        android:id="@+id/cambios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="cambiar"
        android:text="Cambios de comida"
        android:layout_margin="20dp"/>

    <Button
        android:id="@+id/bajas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:onClick="eliminar"
        android:text="Bajas de comida" />

    <Button
        android:id="@+id/consultas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:onClick="consultar"
        android:text="Consultas de comida" />

</LinearLayout>